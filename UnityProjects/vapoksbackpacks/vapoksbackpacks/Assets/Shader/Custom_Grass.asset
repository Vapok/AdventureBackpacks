          UNITY_VERTEX_INPUT_INSTANCE_ID\n};\n\n// vertex-to-fragment interpolators\nstruct
          v2f {\n  fixed4 color : COLOR0;\n  #if ENABLE_SPECULAR\n  fixed3 specColor
