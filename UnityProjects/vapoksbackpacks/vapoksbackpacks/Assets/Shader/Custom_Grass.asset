          fixed4 col;\n  fixed4 tex, tmp0, tmp1, tmp2;\n  // SetTexture #0\n  tex
          = tex2D (_MainTex, IN.uv0.xy);\n  col.rgb = tex * IN.color;\n  col *= 2;\n 
          col.a = fixed4(1,1,1,1).a;\n  #if ENABLE_SPECULAR\n  // add specular color\n 
          col.rgb += IN.specColor;\n  #endif\n  // fog\n  #if USING_FOG\n    col.rgb
          = lerp (unity_FogColor.rgb, col.rgb, IN.fog);\n  #endif\n  return col;\n}\n\n//
